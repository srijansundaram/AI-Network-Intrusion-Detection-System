# Copy to .env and adjust as needed. All vars are prefixed NIDS_ (see app/config.py)

NIDS_DEFAULT_INTERFACE=eth0
NIDS_MODEL_PATH=app/models/nids_model.joblib
NIDS_SCALER_PATH=app/models/scaler.joblib
NIDS_LABEL_ENCODER_PATH=app/models/label_encoder.joblib

NIDS_FLOW_FLUSH_INTERVAL_SEC=2.0
NIDS_INFERENCE_LATENCY_BUDGET_MS=10.0
NIDS_ALERT_THRESHOLD=0.5
NIDS_DEFAULT_REPLAY_SPEED=1.0
NIDS_METRICS_WINDOW_SIZE=500
