      "Each row must sum to 1 within numerical tolerance.",
      "Columns must follow the documented class order.",
      "Rows must correspond to the intended observations."
    ],
    "source": "Frozen RF-LSTM weighted-voting ensemble output; RF weight 0.75 and LSTM weight 0.25."
  },
  "calibration_operation": {
    "method": "multiclass_temperature_scaling",
    "formula": "P_calibrated = softmax(log(P_input_clipped) / T)",
    "temperature": 0.7703281965251618,
    "temperature_must_be_positive": true,
    "note": "The persisted implementation must be used for inference. The formula describes the probability-to-logit form of temperature scaling; numerical clipping is required before taking logarithms."
  },
  "output_contract": {
    "calibrated_probabilities": {
      "shape": [
        "n_observations",
        9
      ],
      "class_order": [
        "BENIGN",
        "DDoS",
        "Port Scan",
        "Brute Force",
        "Bot",
        "Web Attack",
        "Infiltration",
        "DoS",
        "Heartbleed"
      ],
      "semantics": "Normalized post-temperature-scaling class probability scores. They are model outputs, not guarantees of the true probability of an event."
    },
    "predicted_class": {
      "shape": [
        "n_observations"
      ],
      "derivation": "argmax(calibrated_probabilities, axis=1)",
      "representation": "integer class ID mapped through class_order"
    },
    "confidence_score": {
      "shape": [
        "n_observations"
      ],
      "derivation": "max(calibrated_probabilities, axis=1)",
      "range": [
        0.0,
        1.0
      ],
      "semantics": "Maximum calibrated class probability for each observation."
    }
  },
